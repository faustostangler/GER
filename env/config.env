# =============================================================================
# env/config.env — Configuração de Container (Runtime Environment)
# =============================================================================
#
# WHY: Injetado via `env_file:` nos containers em runtime. Diferente do
# env/compose.env, estas variáveis NÃO afetam o parsing do YAML do Compose.
# Variáveis de domínio (EXTERNAL_DOMAIN, IAM_SUBDOMAIN etc.) DEVEM ser
# duplicadas aqui para que o código da aplicação possa lê-las via os.getenv()
# ou pydantic-settings. O env/compose.env é a Fonte de Verdade; este arquivo
# as recebe para disponibilizá-las dentro dos containers.
#
# REGRA: Sem ${VAR} aninhados — apenas literais. (compose NÃO expande env_file)
# =============================================================================

# --- Infraestrutura & Orquestração ---
COMPOSE_PROJECT_NAME=ger
DOCKER_RESTART_POLICY=unless-stopped
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=3

# --- Rede & Domínio (literais — sincronizar com env/compose.env ao mudar) ---
EXTERNAL_IP=127.0.0.1
EXTERNAL_DOMAIN=127.0.0.1.nip.io
PROJECT_DOMAIN=127.0.0.1.nip.io
PROTOCOL=http

# --- Subdomínios ---
IAM_SUBDOMAIN=iam.127.0.0.1.nip.io
ANALYTICS_SUBDOMAIN=analytics.127.0.0.1.nip.io

# --- Analytics Service (Streamlit) ---
ANALYTICS_SERVICE_NAME=analytics
ANALYTICS_INTERNAL_PORT=8501
ANALYTICS_MEM_LIMIT=4G
ANALYTICS_MEM_RESERVATION=1G

# --- Identity & Access Management (IAM) ---
KEYCLOAK_IMAGE_NAME=quay.io/keycloak/keycloak
KEYCLOAK_IMAGE_VERSION=24.0.2
KEYCLOAK_INTERNAL_PORT=8080
KEYCLOAK_EXTERNAL_PORT=8080
KEYCLOAK_MEM_LIMIT=2G
# URL pública do Keycloak (usada por browsers e pelo JWT 'iss' claim)
# Para contexto REMOTO: ex: https://iam.gercon.example.com
KEYCLOAK_SERVER_URL=http://iam.127.0.0.1.nip.io:8080
KEYCLOAK_REALM=gercon-realm
KEYCLOAK_CLIENT_ID=gercon-analytics

# Split-Horizon DNS: hostname interno Docker para o Keycloak
# WHY: Containers acessam o Keycloak via service name Docker (mesh interno).
# O hostname público (IAM_SUBDOMAIN) só é resolvível pelo browser do cliente.
# Mude APENAS se o service name no docker-compose.yml mudar.
KEYCLOAK_INTERNAL_SERVICE=keycloak
KEYCLOAK_INTERNAL_PORT=8080

OAUTH2_PROXY_IMAGE_NAME=quay.io/oauth2-proxy/oauth2-proxy
OAUTH2_PROXY_IMAGE_VERSION=v7.6.0
OAUTH2_PROXY_INTERNAL_PORT=4180
OAUTH2_PROXY_EXTERNAL_PORT=80

# --- SRE: Split Horizon DNS (OIDC) ---
# WHY: LOGIN_URL usa hostname público (browser → Keycloak via redirect).
#      REDEEM/JWKS/VALIDATE usam hostname interno Docker (proxy → keycloak mesh).
#      Esta separação é a essência do Split-Horizon: dois planos DNS, uma sessão.
# Para contexto REMOTO: ajuste LOGIN_URL para o domínio remoto; REDEEM/JWKS/VALIDATE
# sempre usam o hostname interno (keycloak:8080) — não mudam entre contextos.
OAUTH2_PROXY_LOGIN_URL=http://iam.127.0.0.1.nip.io:8080/realms/gercon-realm/protocol/openid-connect/auth
OAUTH2_PROXY_REDEEM_URL=http://keycloak:8080/realms/gercon-realm/protocol/openid-connect/token
OAUTH2_PROXY_OIDC_JWKS_URL=http://keycloak:8080/realms/gercon-realm/protocol/openid-connect/certs
OAUTH2_PROXY_VALIDATE_URL=http://keycloak:8080/realms/gercon-realm/protocol/openid-connect/userinfo
OAUTH2_PROXY_OIDC_ISSUER_URL=http://keycloak:8080/realms/gercon-realm

# --- Persistência, Cache & Event Streaming ---
REDPANDA_IMAGE_VERSION="v23.3.11"
KAFKA_URL="redpanda-0:9092"
POSTGRES_IMAGE_NAME=postgres
POSTGRES_IMAGE_VERSION=15-alpine
KEYCLOAK_DB_MEM_LIMIT=1G
POSTGRES_DB=keycloak

REDIS_IMAGE_NAME=redis
REDIS_IMAGE_VERSION=7-alpine
REDIS_SESSION_MEM_LIMIT=256M
REDIS_QUEUE_MEM_LIMIT=256M

# --- Workers & Healthchecks ---
WORKER_MEM_LIMIT=2G
HEALTHCHECK_INTERVAL=2s
HEALTHCHECK_TIMEOUT=2s
HEALTHCHECK_RETRIES=30

# --- Redes Internas ---
INFRA_NETWORK_NAME=infra-mesh
IAP_NETWORK_NAME=iap-mesh

# --- Regras de Negócio ---
ENVIRONMENT=production
CSV_FILE=dados_gercon.csv
PAGE_SIZE=10
HEADLESS=False
TIMEOUT=300000

# --- Requisitos de Aplicação (Fail-Fast) ---
APP__ENVIRONMENT=production
APP__DEBUG=false
LOG_LEVEL=INFO
# SRE/Security: Guarda dupla para bypass de autenticação em DEV.
# WHY: ENVIRONMENT=dev sozinho não é suficiente para ativar o mock user.
# Esta variável é o segundo fator explícito de opt-in.
# NUNCA deve estar presente em Cloud Run ou ambientes de produção.
ALLOW_UNAUTHENTICATED_DEV=false

# --- Requisitos de Banco e Cache para o Pydantic ---
DB__USER=postgres
DB__PASSWORD=postgres
DB__NAME=fly_ai_db
DB_SERVICE_NAME=db
DB_INTERNAL_PORT=5432
REDIS__HOST=cache
REDIS__PORT=6379

# --- Proxy Specifics ---
OAUTH2_PROXY_UPSTREAMS=http://router:80
OAUTH2_PROXY_COOKIE_SECURE=false
OAUTH2_PROXY_EMAIL_DOMAINS="*"

# --- S3 Storage Configuration ---
S3_BUCKET_NAME=gercon
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
